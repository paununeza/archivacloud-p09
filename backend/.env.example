# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_NAME=archivacloud-p09-pna

# Application Settings
PRESIGNED_URL_TTL=3600
ALLOWED_EXTENSIONS=png,svg
MAX_FILE_SIZE_MB=6

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# No incluir AWS_ACCESS_KEY_ID ni AWS_SECRET_ACCESS_KEY
# El SDK de AWS las tomará automáticamente de:
# 1. AWS CLI configurada (aws configure)
# 2. Variables de entorno del sistema
# 3. Rol de IAM (en Learner Lab)